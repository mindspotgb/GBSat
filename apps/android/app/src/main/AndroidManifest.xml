<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name="app.gbsat.emulator.GBSatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_controller_transparent"
        android:roundIcon="@mipmap/ic_controller_transparent"
        android:label="${appLabel}"
        android:theme="@style/Theme.GBSat">
        <meta-data
            android:name="gb.frame.bitmapLauncherAlias"
            android:value="app.gbsat.emulator.BitmapLauncherActivity" />
        <meta-data
            android:name="gb.frame.adaptiveLauncherAlias"
            android:value="app.gbsat.emulator.AdaptiveLauncherActivity" />
        <!-- Lets the on-device profiler (simpleperf, adb shell) sample GBSat; no effect for users -->
        <profileable android:shell="true" />
        <activity
            android:name="app.gbsat.emulator.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|smallestScreenSize"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GBSat.Launch">
            <!-- Let Android frontends (ES-DE, Daijisho, Pegasus, etc.) open supported Saturn disc images. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.chd" />
                <data android:pathPattern=".*\\.CHD" />
                <data android:pathPattern=".*\\.cue" />
                <data android:pathPattern=".*\\.CUE" />
                <data android:pathPattern=".*\\.iso" />
                <data android:pathPattern=".*\\.ISO" />
                <data android:pathPattern=".*\\.mds" />
                <data android:pathPattern=".*\\.MDS" />
                <data android:pathPattern=".*\\.ccd" />
                <data android:pathPattern=".*\\.CCD" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.7Z" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.RAR" />
            </intent-filter>
            <!-- Some frontends send file/content URIs without a MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:pathPattern=".*\\.chd" />
                <data android:pathPattern=".*\\.CHD" />
                <data android:pathPattern=".*\\.cue" />
                <data android:pathPattern=".*\\.CUE" />
                <data android:pathPattern=".*\\.iso" />
                <data android:pathPattern=".*\\.ISO" />
                <data android:pathPattern=".*\\.mds" />
                <data android:pathPattern=".*\\.MDS" />
                <data android:pathPattern=".*\\.ccd" />
                <data android:pathPattern=".*\\.CCD" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.7Z" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.RAR" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="app.gbsat.emulator.BitmapLauncherActivity"
            android:targetActivity="app.gbsat.emulator.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_controller_transparent"
            android:roundIcon="@mipmap/ic_controller_transparent"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="app.gbsat.emulator.AdaptiveLauncherActivity"
            android:targetActivity="app.gbsat.emulator.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_controller_adaptive"
            android:roundIcon="@mipmap/ic_controller_adaptive"
            android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
